import os
import asyncio
from aiogram import Bot, Dispatcher, F
from aiogram.filters import CommandStart
from aiogram.types import Message
from aiogram.utils.keyboard import ReplyKeyboardBuilder

TOKEN = os.getenv("8606124878:AAHQnhNNQQ8QBDEeAgKfXUA04iAWxWKgbJ4")

bot = Bot(token=TOKEN)
dp = Dispatcher()

def main_menu():
    kb = ReplyKeyboardBuilder()

    buttons = [
        "🛍 Product Store",
        "👤 My Profile",
        "💰 Add Balance",
        "🗝 All History",
        "👥 Referral",
        "🎬 Tutorials",
        "🆘 Support",
        "📥 Download Files",
        "🤝 Reseller Panel"
    ]

    for button in buttons:
        kb.button(text=button)

    kb.adjust(1, 2, 2, 2, 2)
    return kb.as_markup(resize_keyboard=True)

@dp.message(CommandStart())
async def start(message: Message):
    await message.answer(
        "✨ WELCOME TO THE STORE\n\n"
        "🛍 Product Store: Purchase products\n"
        "👤 My Profile: Account information\n"
        "💰 Add Balance: Deposit request\n"
        "🗝 All History: Purchase history\n"
        "👥 Referral: Invite friends\n"
        "🎬 Tutorials: Tutorials\n"
        "🆘 Support: Contact support\n"
        "📥 Download Files: Download section\n"
        "🤝 Reseller Panel: Reseller section",
        reply_markup=main_menu()
    )

